{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.school/playbook/page-family-requirements.schema.json",
  "type": "object",
  "required": ["version", "asOf", "scope", "commonRequiredFields", "families"],
  "properties": {
    "version": { "type": "string" },
    "asOf": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "scope": { "type": "string" },
    "commonRequiredFields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "humanFile", "knownObjectIds", "required", "sources", "ownerRole", "status"],
        "properties": {
          "id": { "type": "string" },
          "humanFile": { "type": "string" },
          "knownObjectIds": { "type": "array", "items": { "type": "number" } },
          "required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "ownerRole": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
