{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha.school/playbook/actor-capabilities.schema.json",
  "type": "object",
  "required": ["version", "asOf", "scope", "statuses", "actors", "alphaMcpToolInventory"],
  "properties": {
    "version": { "type": "string" },
    "asOf": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "scope": { "type": "string" },
    "statuses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "environment", "operations", "source", "notes"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "environment": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "operations": { "type": "object" },
          "source": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "alphaMcpToolInventory": {
      "type": "object",
      "required": ["versionObserved", "tools"],
      "properties": {
        "versionObserved": { "type": "string" },
        "tools": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
