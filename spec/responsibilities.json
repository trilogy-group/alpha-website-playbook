{
  "$comment": "Who is responsible for what: departments, then roles, then ticket-class routing. People are in registry/people.json and registry/campus-leadership.json because people change and roles do not. Sources: named decisions (Matt Barge 2026-09-15: Hailey McSpadden owns HubSpot), website staff cards, APEX requester history, observer routing rules, marketingsupport registry.",
  "version": "0.1",
  "departments": {
    "campus-leadership": {
      "scope": "one campus each",
      "roles": [
        "head-of-schools",
        "dean-of-parents",
        "director-of-admissions",
        "head-guide",
        "lead-guide",
        "campus-coordinator"
      ],
      "note": "Submit most website tickets. Not in charge of website choices. They hold the bios, photos, titles, names, and campus facts the website shows."
    },
    "marketing": {
      "scope": "all Alpha campuses",
      "roles": [
        "website-operations",
        "website-agent-operator",
        "packet-owner",
        "events",
        "pr-comms",
        "brand-authority"
      ]
    },
    "hubspot": {
      "scope": "all",
      "roles": [
        "hubspot-owner"
      ],
      "note": "HubSpot is the source of truth for campus state and facts (decision 2026-09-15)."
    },
    "expansion": {
      "scope": "pre-announcement and announced campuses",
      "roles": [
        "expansion-new-programs",
        "expansion-founding"
      ]
    },
    "web-platform": {
      "scope": "all",
      "roles": [
        "elementor-owner",
        "wordpress-admin"
      ],
      "note": "Owner not yet named; see gaps."
    },
    "operations": {
      "scope": "all",
      "roles": [
        "operations-sheet-owner",
        "growth-map-owner"
      ],
      "note": "Owner not yet named; see gaps."
    },
    "qc": {
      "scope": "all",
      "roles": [
        "observer-owner"
      ]
    }
  },
