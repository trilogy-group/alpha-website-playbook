  "ticketRouting": {
    "$comment": "class -> who supplies missing inputs, who approves, who executes. Campus roles resolve to a person through registry/campus-leadership.json for the ticket's campus.",
    "staff-add": {
      "supplies": "dean-of-parents or director-of-admissions (the requester)",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "staff-update": {
      "supplies": "requester",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "staff-remove": {
      "supplies": "requester",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "staff-photo": {
      "supplies": "requester",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "program-info": {
      "supplies": "director-of-admissions",
      "approves": "hubspot-owner (record) then director-of-admissions",
      "executes": "website-agent-operator"
    },
    "copy": {
      "supplies": "requester",
      "approves": "dean-of-parents; brand-authority if wording is new",
      "executes": "website-agent-operator"
    },
    "observer-launch-copy": {
      "supplies": "website-operations (card)",
      "approves": "none (fixed wording)",
      "executes": "website-agent-operator"
    },
    "observer-fact-sync": {
      "supplies": "hubspot-owner",
      "approves": "hubspot-owner",
      "executes": "website-agent-operator"
    },
    "observer-media-identity": {
      "supplies": "website-operations",
      "approves": "website-operations",
      "executes": "website-agent-operator"
    },
    "observer-brand-leak": {
      "supplies": "dean-of-parents (replacement copy)",
      "approves": "website-operations",
      "executes": "website-agent-operator"
    },
    "observer-link-cta": {
      "supplies": "director-of-admissions or packet-owner or hubspot-owner (admission_link)",
      "approves": "director-of-admissions",
      "executes": "website-agent-operator"
    },
    "observer-packet": {
      "supplies": "packet-owner",
      "approves": "packet-owner",
      "executes": "website-agent-operator (link) / packet-owner (document)"
    },
    "observer-event": {
      "supplies": "hubspot-owner / events",
      "approves": "events",
      "executes": "hubspot-owner"
    },
    "observer-layout": {
      "supplies": "",
      "approves": "elementor-owner",
      "executes": "elementor-owner"
    },
    "observer-map-community": {
      "supplies": "operations-sheet-owner / expansion-new-programs",
      "approves": "operations",
      "executes": "growth-map-owner"
    },
    "observer-health": {
      "supplies": "",
      "approves": "",
      "executes": "observer-owner"
    },
    "other-workflow": {
      "supplies": "",
      "approves": "",
      "executes": "the owning workflow (packets, new program, videography, PR, brand)"
    }
