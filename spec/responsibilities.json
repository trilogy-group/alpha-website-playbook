  "ticketRouting": {
    "$comment": "class -> who supplies missing inputs, who approves, who executes. Campus roles resolve to a person through registry/campus-leadership.json for the ticket's campus.",
    "staff-add": {
      "supplies": "dean-of-parents or director-of-admissions (the requester)",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "staff-update": {
      "supplies": "requester",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "staff-remove": {
      "supplies": "requester",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "staff-photo": {
      "supplies": "requester",
      "approves": "dean-of-parents",
      "executes": "website-agent-operator"
    },
    "program-info": {
      "supplies": "director-of-admissions",
      "approves": "hubspot-owner (record) then director-of-admissions",
      "executes": "website-agent-operator"
    },
    "copy": {
      "supplies": "requester",
      "approves": "dean-of-parents; brand-authority if wording is new",
      "executes": "website-agent-operator"
    },
    "observer-launch-copy": {
      "supplies": "website-operations (card)",
      "approves": "none (fixed wording)",
      "executes": "website-agent-operator"
    },
    "observer-fact-sync": {
      "supplies": "hubspot-owner",
      "approves": "hubspot-owner",
      "executes": "website-agent-operator"
    },
    "observer-media-identity": {
      "supplies": "website-operations",
      "approves": "website-operations",
      "executes": "website-agent-operator"
    },
    "observer-brand-leak": {
      "supplies": "dean-of-parents (replacement copy)",
      "approves": "website-operations",
      "executes": "website-agent-operator"
    },
    "observer-link-cta": {
      "supplies": "director-of-admissions or packet-owner or hubspot-owner (admission_link)",
      "approves": "director-of-admissions",
      "executes": "website-agent-operator"
    },
    "observer-packet": {
      "supplies": "packet-owner",
      "approves": "packet-owner",
      "executes": "website-agent-operator (link) / packet-owner (document)"
    },
    "observer-event": {
      "supplies": "hubspot-owner / events",
      "approves": "events",
      "executes": "hubspot-owner"
    },
    "observer-layout": {
      "supplies": "",
      "approves": "elementor-owner",
      "executes": "elementor-owner"
    },
    "observer-map-community": {
      "supplies": "operations-sheet-owner / expansion-new-programs",
      "approves": "operations",
      "executes": "growth-map-owner"
    },
    "observer-health": {
      "supplies": "",
      "approves": "",
      "executes": "observer-owner"
    },
    "other-workflow": {
      "supplies": "",
      "approves": "",
      "executes": "the owning workflow (packets, new program, videography, PR, brand)"
    }
  },
  "gaps": [
    "elementor-owner not named",
    "operations-sheet-owner and growth-map-owner not named",
    "12 campus pages show no Dean of Parents and 17 show no Director of Admissions; either the role is vacant or the card is missing",
    "Slack directory visible to the bot covers 28 members; users:read at workspace level would give titles for everyone",
    "HubSpot Programs object properties still unreadable with the marketing token (needs crm.objects.custom.read and crm.schemas.custom.read); campus state and facts are read through the public growth map API until Hailey or a HubSpot admin grants the scopes",
    "The Admissions Hub org chart has no owner named on the page; Hailey confirms roster corrections today. Confirm who edits the chart and how often",
    "HubSpot owner records are missing or personal for several roster names (Gaby Sullivan present; Samantha Kravitz, Morgan Petek, Q Tang, Crystal Cybulski, Nancy Wisniewski Torvund absent; Haven Mass under a personal address); the resolver reports email null for them",
    "Elementor owner, Operations sheet owner, and growth map owner are still not named"
  ],
  "registryByTicketClass": {
    "$comment": "What an agent must have on hand, and where it comes from, before it can validate, route, or execute a ticket of each class. live = resolve at run time; registry = read the committed file; source = read the system of record.",
    "staff-add": {
      "needs": {
        "campus page and section model": "registry/campus-pages.json, spec/campus-page-model.json",
        "approver: Dean of Parents for the campus": "live (tests/resolve-campus-roles.mjs); fallback Head of Schools from registry/campus-leadership.json; fallback Dean of Parents - Expansion from registry/people.json",
        "approved titles list": "spec/campus-page-requirements.json (team section)",
        "headshot mapping": "the ticket (requester confirmation), never inferred"
      },
      "missingInfoGoesTo": "dean-of-parents (live) -> head-of-schools -> website-operations"
    },
    "staff-update": {
      "needs": {
        "current card": "MCP find_elementor_component",
        "approver": "dean-of-parents (live)"
      },
      "missingInfoGoesTo": "requester, then dean-of-parents"
    },
    "staff-remove": {
      "needs": {
        "effective date": "the ticket",
        "approver": "dean-of-parents (live)"
      },
      "missingInfoGoesTo": "dean-of-parents"
    },
    "staff-photo": {
      "needs": {
        "name-to-photo mapping": "the ticket (explicit)",
        "approver": "dean-of-parents (live)"
      },
      "missingInfoGoesTo": "requester"
    },
    "program-info": {
      "needs": {
        "the fact in HubSpot Programs": "source (HubSpot; growth map API as the public mirror)",
        "who can change HubSpot": "hubspot-owner from registry/people.json",
        "who speaks for the campus": "director-of-admissions (live); senior-admissions-specialist (live) for pre-open campuses"
      },
      "missingInfoGoesTo": "hubspot-owner when HubSpot is blank; director-of-admissions when the requester disagrees with HubSpot"
    },
    "observer-fact-sync": {
      "needs": {
        "HubSpot value": "source",
        "Operations sheet value": "source",
        "owner of the HubSpot record": "hubspot-owner (registry)"
      },
      "missingInfoGoesTo": "hubspot-owner"
    },
    "copy": {
      "needs": {
        "brand rules": "marketingsupport docs/rules/alpha-brand-copy-rules.md; alpha-branding-skill",
        "brand authority for new wording": "brand-authority (registry: MacKenzie Price)",
        "campus sign-off": "dean-of-parents (live)"
      },
      "missingInfoGoesTo": "requester; brand-authority for held items"
    },
    "observer-launch-copy": {
      "needs": {
        "campus state": "source (HubSpot via growth map API)",
        "approved card asset": "registry/campus-open-media.json",
        "card producer": "website-operations (registry: Yash Chitneni)"
      },
      "missingInfoGoesTo": "website-operations"
    },
    "media": {
      "needs": {
        "approved asset": "registry/campus-open-media.json or the ticket",
        "photo or video source": "photography / videography (registry)"
      },
      "missingInfoGoesTo": "website-operations; photography or videography for sourcing"
    },
    "observer-media-identity": {
      "needs": {
        "approved asset": "registry/campus-open-media.json"
      },
      "missingInfoGoesTo": "website-operations"
    },
    "observer-brand-leak": {
      "needs": {
        "exception list": "spec/site-rules.json site.identity",
        "replacement copy": "dean-of-parents (live)"
      },
      "missingInfoGoesTo": "dean-of-parents"
    },
    "link-cta": {
      "needs": {
        "destination": "the ticket or HubSpot admission_link (source)",
        "calendar owner for calendar links": "calendars (registry: Zara Raheem)",
        "packet owner for packet links": "packet-owner (registry)"
      },
      "missingInfoGoesTo": "director-of-admissions (live) for apply links; calendars; packet-owner"
    },
    "observer-link-cta": {
      "needs": {
