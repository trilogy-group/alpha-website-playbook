{
  "$comment": "Who is responsible for what: departments, then roles, then ticket-class routing. People are in registry/people.json because people change and roles do not. Campus roles (Director of Admissions, Dean of Parents, Senior Admissions Specialist) are LIVE: resolved from the Admissions Hub org chart by tests/resolve-campus-roles.mjs, with emails from HubSpot owners; registry/campus-roles-snapshot.json is a dated cache, never the source. Department roles are REGISTERED: named in registry/people.json with a source and date. Sources: named decisions (Matt Barge 2026-09-15: Hailey McSpadden owns HubSpot), Admissions Hub, APEX request-type routing and permission files, HubSpot owner teams, website staff cards, APEX requester history, Slack titles.",
  "version": "0.2",
  "departments": {
    "campus-leadership": {
      "scope": "one campus each",
      "roles": [
        "campus-coordinator",
        "dean-of-parents",
        "director-of-admissions",
        "head-guide",
        "head-of-schools",
        "lead-guide",
        "senior-admissions-specialist"
      ],
      "note": "Submit most website tickets. Not in charge of website choices. They hold the bios, photos, titles, names, and campus facts the website shows."
    },
    "marketing": {
      "scope": "all Alpha campuses",
      "roles": [
        "brand-authority",
        "calendars",
        "events",
        "marketing-collateral",
        "packet-owner",
        "photography",
        "pr-comms",
        "video-editing",
        "videography",
        "website-agent-operator",
        "website-operations"
      ]
    },
    "hubspot": {
      "scope": "all",
      "roles": [
        "campus-roles-confirmer",
        "hubspot-admin",
        "hubspot-owner"
      ],
      "note": "HubSpot is the source of truth for campus state and facts (decision 2026-09-15)."
    },
    "expansion": {
      "scope": "pre-announcement and announced campuses",
      "roles": [
        "expansion-new-programs",
        "expansion-founding"
      ]
    },
    "web-platform": {
      "scope": "all",
      "roles": [
        "elementor-owner",
        "wordpress-admin"
      ],
      "note": "Owner not yet named; see gaps."
    },
    "operations": {
      "scope": "all",
      "roles": [
        "operations-sheet-owner",
        "growth-map-owner"
      ],
      "note": "Owner not yet named; see gaps."
    },
    "qc": {
      "scope": "all",
      "roles": [
        "observer-owner"
      ]
    }
  },
